{
  "name": "choux",
  "private": true,
  "type": "module",
  "scripts": {
    "fixture": "bun scripts/generate-fixture.ts",
    "train": "bun scripts/train.ts",
    "self-play": "bun scripts/self-play.ts",
    "collect": "bun scripts/collect.ts",
    "evaluate": "bun scripts/evaluate.ts",
    "benchmark:strength": "bun scripts/benchmark-strength.ts",
    "benchmark:matches": "bun scripts/benchmark-matches.ts",
    "dev": "bun run fixture && bun --bun vite",
    "check": "bun --bun svelte-check --tsconfig ./tsconfig.json",
    "build": "bun run fixture && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "biome:check": "biome check .",
    "biome:format": "biome format --write ."
  },
  "dependencies": {
    "@jax-js/jax": "0.1.27",
    "chess.js": "1.4.0",
    "svelte": "5.59.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.5",
    "svelte-check": "4.7.8",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  }
}
